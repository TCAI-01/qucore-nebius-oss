# =====================================================================================================
# QuCoRe OSS — backend configuration (backend/.env)
#
#   cp backend/.env.example backend/.env      then put your own keys in (bring your own key, BYOK)
#
# Keep every value in this file (Docker mounts it into the container), so the Credentials screen and the
# backend always read the same configuration.
# The Credentials screen in the app edits this file IN PLACE: only the values you change are rewritten;
# these comments, blank lines and the order of the keys are kept exactly as they are.
# Never commit backend/.env (it is in .gitignore). Restart the backend after editing this file by hand.
# =====================================================================================================


# ---------------------------------------------------------------- Nebius Token Factory (required) — bring your own Nebius key
# OpenAI-compatible API base URL, ending in /v1.
NEBIUS_BASE_URL='https://api.tokenfactory.us-central1.nebius.com/v1'
# Your Nebius Token Factory API key (https://tokenfactory.nebius.com). Required for every tool.
NEBIUS_API_KEY=''
# Main model (the header switch changes it). Any model ID your endpoint serves works; NVIDIA Nemotron by default.
NEBIUS_MODEL='nvidia/Nemotron-3-Ultra-550b-a55b'
# Output-token parameter name sent with Chat Completions: max_tokens (recommended) or max_completion_tokens.
NEBIUS_CHAT_TOKEN_PARAMETER='max_tokens'
# Context window and maximum output tokens of NEBIUS_MODEL. Input size is checked against these before any call.
NEBIUS_CONTEXT_WINDOW='928000'
NEBIUS_MAX_OUTPUT_TOKENS='32000'
# Embedding model on Token Factory (QuBot semantic search, "semantic ordering" in QuCodRev).
# Fixed to Qwen/Qwen3-Embedding-8B: the app always uses it (any other value here is ignored; not editable in the UI).
NEBIUS_EMBEDDING_MODEL='Qwen/Qwen3-Embedding-8B'
# Fallback prices in USD per million tokens, used only for models the live price catalogue does not know.
NEBIUS_INPUT_COST_PER_MILLION=''
NEBIUS_OUTPUT_COST_PER_MILLION=''
NEBIUS_EMBEDDING_COST_PER_MILLION=''


# ---------------------------------------------------------------- Nebius sandbox (QuSolids demos)
# Code runs remotely in the Nebius sandbox (contree-sdk), never on this computer. Uses NEBIUS_API_KEY above.
# QuSolids demos: Python for Python files, Node.js for JavaScript / TypeScript files, none for other languages.
# The Nebius project that owns your sandbox, e.g. project-e00abc123...
NEBIUS_PROJECT_ID=''
# Sandbox images, as Docker Hub names. The first run imports the image into your Nebius project (that run
# takes longer); later runs reuse it. Slim images import faster.
# Python demonstrations (findings in .py files). Default python:3.12.
QUCORE_SANDBOX_IMAGE='python:3.12'
# Node.js demonstrations (findings in .js .jsx .ts .tsx files, React included). Default node:22-slim.
QUCORE_SANDBOX_NODE_IMAGE='node:22-slim'


# ---------------------------------------------------------------- Tavily (QuScan) — bring your own Tavily key
# Your Tavily search API key for QuScan's dependency threat intelligence (https://tavily.com).
# Also editable in the app: Credentials > Tavily web search (saved here, never sent back to the browser).
TAVILY_API_KEY=''


# ---------------------------------------------------------------- Tabs and home page
# The app shows 4 tabs (QuReview · QuCoder · QuBot · QuScan) and a home page.
# Optional: which tabs to show (ids: review, coder, qa, quscan). Empty = all four.
QUCORE_TABS='review,coder,qa,quscan'
# Home page sample repositories: owner/repo or owner/repo@ref, comma separated (max 6).
QUCORE_SAMPLE_REPOS='psf/requests,pallets/flask'


# ---------------------------------------------------------------- QuBot (code Q&A)
# First retrieval method shown: cursor | hybrid | default
QUCORE_QA_DEFAULT_METHOD='cursor'
# "Include history": how many previous answers of the same chat are sent with a new question.
QUCORE_QA_HISTORY_TURNS='5'
# Hybrid search weights (semantic vs keyword), files sent in full (hybrid), candidate chunks, snippet budget
# (cursor-style), and how many times a cut-off answer is continued automatically.
QUCORE_QA_SEMANTIC_WEIGHT='0.6'
QUCORE_QA_KEYWORD_WEIGHT='0.4'
QUCORE_QA_TOP_FILES='10'
QUCORE_QA_CANDIDATES='50'
QUCORE_QA_SNIPPET_TOKENS='40000'
QUCORE_QA_MAX_CONTINUATIONS='2'
# Local ChromaDB folder for QuBot vectors. Empty = backend/data/chroma (inside the data folder).
QUCORE_CHROMA_DIR=''


# ---------------------------------------------------------------- Local storage and automatic deletion
# Everything is stored on this computer: backend/data/qucore.db (SQLite), backend/data/chroma (ChromaDB) and
# files in backend/data/* (reports PDF/JSON, analyses, change history, QuBot index state, GitHub downloads).
# 'true' = delete everything inside the sub-folders of backend/data every QUCORE_AUTO_DELETE_DAYS days,
# counted from the first use (backend/data/.first_use). qucore.db (prompts, run lists) and .env are kept.
QUCORE_AUTO_DELETE='false'
QUCORE_AUTO_DELETE_DAYS='7'


# ---------------------------------------------------------------- Live model prices (LiteLLM catalogue)
# 'true' = cost estimates use the current price of the Nebius model in use, from LiteLLM's public price
# catalogue (a JSON file; the litellm package is NOT installed). Unknown models use the fallback prices above.
QUCORE_LIVE_PRICING='true'
# Fetched at most this often (hours) and stored in backend/data/qucore.db. 168 = weekly.
QUCORE_PRICING_REFRESH_HOURS='168'
QUCORE_PRICING_LITELLM_URL='https://raw.githubusercontent.com/BerriAI/litellm/main/model_prices_and_context_window.json'


# ---------------------------------------------------------------- Public GitHub repositories as workspaces
QUCORE_GITHUB_IMPORT='true'
# Optional GitHub token (read-only, public repos) for a higher API rate limit.
QUCORE_GITHUB_TOKEN=''
QUCORE_GITHUB_MAX_MB='100'
# Downloaded repositories are deleted after this many minutes without use ('0' = use QUCORE_GITHUB_CACHE_HOURS).
QUCORE_GITHUB_IDLE_MINUTES='30'
QUCORE_GITHUB_CACHE_HOURS='24'


# ---------------------------------------------------------------- Token estimates and concurrency
QUCORE_TOKEN_ENCODING='o200k_base'
QUCORE_CONTEXT_SAFETY_TOKENS='4096'
# Runs of one tool at the same time, and of all tools together.
QUCORE_RUNS_PER_FEATURE='5'
QUCORE_MAX_ACTIVE_RUNS='12'


# ---------------------------------------------------------------- Server
# Browser origins allowed to call the API (Vite dev server 5173, built UI served by the backend on 8000).
QUCORE_ALLOWED_ORIGINS='http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000,http://127.0.0.1:8000'
# Host names the server answers to.
QUCORE_ALLOWED_HOSTS='localhost,127.0.0.1,[::1]'
